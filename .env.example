# =============================
# ЧистоДвор — конфигурация
# =============================
# Скопируйте этот файл в .env и заполните своими данными

# === ЮКасса (yookassa.ru) ===
# Получите в личном кабинете: https://yookassa.ru/my/settings/integration
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# === Ваш сайт ===
# URL, на который будет возвращаться покупатель после оплаты
# В продакшн: https://вашдомен.ru
BASE_URL=http://localhost:3000

# === Email компании (куда приходят заказы) ===
COMPANY_EMAIL=info@chistodvor.ru

# === SMTP для отправки писем ===
# Gmail: включите двухфакторную аутентификацию и создайте "Пароль приложения"
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# === Сервер ===
PORT=3000

# === Режим демо (без реальной оплаты) ===
# Установите DEMO_MODE=true для тестирования без ЮКасса
DEMO_MODE=false
